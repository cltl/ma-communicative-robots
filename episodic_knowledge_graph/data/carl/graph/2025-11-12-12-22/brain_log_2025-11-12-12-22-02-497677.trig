}

leolaniWorld:leolani_know_carl-1 {
    leolaniWorld:leolani n2mu:know leolaniFriends:carl-1 .
}

leolaniWorld:Claims {
    leolaniFriends:carl-1 owl:sameAs leolaniWorld:carl .

    leolaniWorld:carl-1_like_pills-1 a gaf:Assertion,
            sem:Event ;
        rdfs:label "carl-1_like_pills-1" ;
        gaf:denotedBy leolaniTalk:chat1_utterance1_char0-25 .

    leolaniWorld:leolani_know_carl-1 a gaf:Assertion,
            sem:Event ;
        rdfs:label "leolani_know_carl-1" .
}

leolaniWorld:carl-1_like_pills-1 {
    leolaniWorld:carl-1 n2mu:see leolaniWorld:pills-1 .
}

